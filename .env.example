# Configure ONE of the following LLM provider API keys before running agent.py:

# Option 1: OpenAI API Key (Default if set; uses gpt-4o-mini unless overridden by LLM_MODEL)
OPENAI_API_KEY=your_openai_api_key_here

# Option 2: GitHub Models / Student Copilot Token ([https://models.inference.ai.azure.com](https://models.inference.ai.azure.com); uses gpt-4o)
GITHUB_TOKEN=your_github_pat_here

# Option 3: Google Gemini API Key (OpenAI-compatible endpoint; uses gemini-3.8-flash)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override model name (e.g., gpt-4o, gpt-4o-mini, gemini-3.8-flash)
LLM_MODEL=gpt-4o
